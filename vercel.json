{
  "crons": [
    {
      "path": "/api/cron/renew-webhook",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/recover-webhook",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "src/app/api/drive/webhook/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/renew-webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/recover-webhook/route.ts": {
      "maxDuration": 300
    }
  }
}
